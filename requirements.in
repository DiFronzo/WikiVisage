# WikiVisage web app + background worker — top-level requirements (Python 3.12+).
#
# This is the SOURCE for requirements.txt. Edit here, then regenerate the lock
# from the repository root:
#
#     uv pip compile --universal --python-version 3.12 \
#         -c model-server/requirements.txt requirements.in -o requirements.txt
#
# (uv 0.13.5, the version audit.yml and Dependabot use.) Without --upgrade uv keeps
# the pins already in requirements.txt and only changes what this file demands;
# add --upgrade to also refresh every transitive pin.
#
# requirements.txt is the fully pinned, transitive lock that CI and the Toolforge
# buildpack install, so a deploy no longer picks up whatever PyPI released since
# the last one. Never edit it by hand. Constraining the compile with the face
# service lock (-c) keeps the packages both files pin (requests, Pillow, numpy,
# python-dotenv, ...) on the same versions, because one CI job installs both.
#
# NOTE: dlib / face-recognition are deliberately NOT here.
# Face detection and embedding run in the separate face service
# (see model-server/) and are reached over HTTP via face_client.py.
# Keep this file free of ML dependencies — that is the whole point of the
# split, and it is what keeps the Toolforge image small and buildable.

# Web framework
Flask==3.1.3
gunicorn==26.2.0
# Imported directly (ProxyFix in app.py, HTTPException in tests), so declared
# here instead of relying on Flask's transitive dependency. Flask 3.1 needs >=3.1.
Werkzeug>=3.1.9

# OAuth 2.0
requests-oauthlib==2.0.0
requests>=2.34.2

# Database
PyMySQL==1.2.3
cryptography>=50.0.2

# Numerics
# Used for centroid computation and face-distance math in worker.py. Pure
# wheels on every supported platform — no compiler, no BLAS system packages.
# numpy 2.5 requires Python >=3.12, which is the project's interpreter floor.
numpy>=2.5.4

# Image handling
# Used only for header-only dimension checks before shipping bytes to the
# face service; no decoding of full images happens in these processes.
Pillow>=13.0.0

# Rate limiting
Flask-Limiter==4.1.1
# redis-py 8.1 works for every path this app uses: the limiter's fixed-window
# and moving-window storage plus the Lua compare-and-delete in redis_lock.py.
# limits 5.8 still declares redis<8.0.0 on its optional [redis] extra, so keep
# an eye on that when upgrading either package.
redis>=8.1.0

# Internationalization
Flask-Babel==4.0.0

# Environment variables from .env files.
# Kept a range, not a pin: model-server/requirements.txt pins python-dotenv
# transitively and CI resolves both files in one install.
python-dotenv>=1.2.4
