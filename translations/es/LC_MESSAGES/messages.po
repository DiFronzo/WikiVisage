msgstr "Guardar configuración"

#: templates/account_settings.html:97
msgid "Sessions"
msgstr "Sesiones"

#: templates/account_settings.html:98
msgid ""
"Log out on every browser and device where you are signed in, including "
"this one."
msgstr ""
"Cierra sesión en todos los navegadores y dispositivos donde hayas "
"iniciado sesión, incluido este."

#: templates/account_settings.html:99
msgid "Log out on all devices?"
msgstr "¿Cerrar sesión en todos los dispositivos?"

#: templates/account_settings.html:101
