msgid "Access is currently restricted to approved testers."
msgstr "El acceso está restringido actualmente a probadores aprobados."

#: app.py:888
msgid "Database error. Please try again."
msgstr "Error de base de datos. Por favor, inténtalo de nuevo."

#: app.py:914
msgid "You have been logged out."
msgstr "Has cerrado sesión."

#: app.py:1044
msgid "Failed to load projects."
msgstr "Error al cargar los proyectos."

#: app.py:1251 app.py:1795 app.py:1960 app.py:2038 app.py:2321 app.py:2477
