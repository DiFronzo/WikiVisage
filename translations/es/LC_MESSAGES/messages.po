#: app.py:390
msgid "Invalid bounding box dimensions"
msgstr "Dimensiones del cuadro delimitador no válidas"

#: app.py:399
msgid "Bounding box out of allowed range"
msgstr "El cuadro delimitador está fuera del rango permitido"

#: app.py:510
msgid "Please log in to continue."
msgstr "Por favor, inicia sesión para continuar."

#: app.py:1181
msgid "Invalid OAuth state. Please try again."
msgstr "Estado de OAuth no válido. Por favor, inténtalo de nuevo."

#: app.py:1200
msgid "Authentication failed. Please try again."
msgstr "La autenticación falló. Por favor, inténtalo de nuevo."

#: app.py:1214
msgid "Could not retrieve your profile. Please try again."
msgstr "No se pudo recuperar tu perfil. Por favor, inténtalo de nuevo."

#: app.py:1221
msgid "Invalid profile data received."
msgstr "Se recibieron datos de perfil no válidos."

#: app.py:1263
msgid "Database error. Please try again."
msgstr "Error de base de datos. Por favor, inténtalo de nuevo."

#: app.py:1288
msgid "You have been logged out."
msgstr "Has cerrado sesión."

#: app.py:1489
msgid "Failed to load projects."
msgstr "Error al cargar los proyectos."

#: app.py:1682 app.py:2239 app.py:2419 app.py:2637 app.py:2988 app.py:3202
#: app.py:3405 app.py:3528 app.py:3865 app.py:3983 app.py:4031 app.py:4074
#: app.py:4110 app.py:4167 app.py:4242 app.py:4419 app.py:4449
msgid "Invalid CSRF token"
msgstr "Token CSRF no válido"

#: app.py:1693
msgid "Wikidata Q-ID must start with 'Q' (e.g., Q42)."
msgstr "El Q-ID de Wikidata debe comenzar con 'Q' (ej. Q42)."

#: app.py:1695
msgid "Commons category is required."
msgstr "Se requiere una categoría de Commons."

#: app.py:1700 app.py:3877
msgid "Distance threshold must be between 0.1 and 1.0."
msgstr "El umbral de distancia debe estar entre 0.1 y 1.0."

#: app.py:1702 app.py:3879
msgid "Distance threshold must be a number."
msgstr "El umbral de distancia debe ser un número."

#: app.py:1708 app.py:3885
msgid "Minimum confirmed must be at least 1."
msgstr "El mínimo confirmado debe ser al menos 1."

#: app.py:1710 app.py:3887
msgid "Minimum confirmed must be a whole number."
msgstr "El mínimo confirmado debe ser un número entero."

#: app.py:1718
#, python-format
msgid ""
"The Wikidata entity %(qid)s is not an instance of human (Q5). Only human "
"entities are supported."
msgstr ""
"La entidad de Wikidata %(qid)s no es una instancia de humano (Q5). Solo "
"se admiten entidades humanas."

#: app.py:1728
#, python-format
msgid "The Commons category \"%(category)s\" does not exist."
msgstr "La categoría de Commons \"%(category)s\" no existe."

#: app.py:1735
#, python-format
msgid "The Commons category \"%(category)s\" exists but contains no files."
msgstr "La categoría de Commons \"%(category)s\" existe pero no contiene archivos."

#: app.py:1760
msgid "A project with this Q-ID and category already exists."
msgstr "Ya existe un proyecto con este Q-ID y categoría."

#: app.py:1790 app.py:4213
msgid "You are already a member of this project."
msgstr "Ya eres miembro de este proyecto."

#: app.py:1795
#, python-format
msgid ""
"%(username)s already has a project for this Q-ID and category. You can "
"ask them for an invite code to join, or create your own."
msgstr ""
"%(username)s ya tiene un proyecto para este Q-ID y categoría. Puedes "
"pedirle un código de invitación para unirte, o crear el tuyo propio."

#: app.py:1846
msgid "Project created successfully!"
msgstr "¡Proyecto creado con éxito!"

#: app.py:1865 app.py:1877
msgid "Failed to create project. Please try again."
msgstr "Error al crear el proyecto. Por favor, inténtalo de nuevo."

#: app.py:1870
msgid ""
"A previously deleted project with this Q-ID and category is still being "
"cleaned up. Please try again in a minute."
msgstr ""
"Un proyecto eliminado anteriormente con este Q-ID y categoría aún se está"
" limpiando. Por favor, inténtalo de nuevo en un minuto."

#: app.py:2247 app.py:2656 app.py:2994 app.py:3211
msgid "Missing required fields"
msgstr "Faltan campos requeridos"

#: app.py:2253 app.py:2666 app.py:3002 app.py:3220
msgid "Invalid field values"
msgstr "Valores de campo no válidos"

#: app.py:2259 app.py:2458 app.py:2692
msgid "Image not found or access denied"
msgstr "Imagen no encontrada o acceso denegado"

#: app.py:2261 app.py:2435 app.py:2460 app.py:2503 app.py:2694 app.py:3022
#: app.py:3045 app.py:3248 app.py:3413 app.py:3434 app.py:3462 app.py:3485
#: app.py:3507 app.py:3535 app.py:3547 app.py:3570 app.py:3625 app.py:3718
#: app.py:3786
msgid "Database error"
msgstr "Error de base de datos"

#: app.py:2335
msgid "Invalid face ID"
msgstr "ID de rostro no válido"

#: app.py:2408
msgid "Failed to save classification"
msgstr "Error al guardar la clasificación"

#: app.py:2423 app.py:2452
msgid "Nothing to undo"
msgstr "Nada que deshacer"

#: app.py:2433
msgid "Project not found"
msgstr "Proyecto no encontrado"

#: app.py:2523 app.py:3051
msgid "OAuth token expired. Please log in again."
msgstr "El token de OAuth ha caducado. Por favor, inicia sesión de nuevo."

#: app.py:2525
msgid ""
"Failed to remove SDC claim from Commons. The classification was not "
"undone."
msgstr ""
"Error al eliminar la declaración SDC de Commons. La clasificación no se "
"deshizo."

#: app.py:2597
msgid "Failed to undo classification"
msgstr "Error al deshacer la clasificación"

#: app.py:2602 templates/project_detail.html:869
msgid "SDC claim was removed."
msgstr "Se eliminó la declaración SDC."

#: app.py:2604 templates/project_detail.html:870
msgid "SDC claim removal queued."
msgstr "Eliminación de declaración SDC en cola."

#: app.py:2684
msgid "Too many face IDs in dismiss list"
msgstr "Demasiados identificadores de rostro en la lista de descarte"

#: app.py:2697 app.py:3252
msgid "Image has not finished processing yet"
msgstr "La imagen aún no ha terminado de procesarse"

#: app.py:2714 app.py:3289
msgid "This image could not be read by the face detection service."
msgstr "Esta imagen no pudo ser leída por el servicio de detección de rostros."

#: app.py:2717 app.py:3292
msgid "Face detection service is unavailable. Please try again in a moment."
msgstr ""
"El servicio de detección de rostros no está disponible. Inténtalo de "
"nuevo en unos momentos."

#: app.py:2723 app.py:3298
msgid ""
"Could not compute face encoding for the selected region. Try drawing a "
"slightly larger box."
msgstr ""
"No se pudo calcular la codificación del rostro para la región "
"seleccionada. Intenta dibujar un cuadro un poco más grande."

#: app.py:2832 app.py:3373
msgid "Failed to download image from Commons"
msgstr "Error al descargar la imagen de Commons"

#: app.py:2835 app.py:3391
msgid "Failed to save face"
msgstr "Error al guardar el rostro"

#: app.py:2838 app.py:3394
msgid "Failed to process face region"
msgstr "Error al procesar la región del rostro"

#: app.py:3020 app.py:3246 app.py:3387
msgid "Face not found or access denied"
msgstr "Rostro no encontrado o acceso denegado"

#: app.py:3056
msgid "Failed to remove SDC claim from Commons. The face was not reclassified."
msgstr ""
"Error al eliminar la declaración SDC de Commons. El rostro no fue "
"reclasificado."

#: app.py:3164 app.py:3263 app.py:3380
#, python-format
msgid ""
"This face was already classified by %(user)s. Only they can change their "
"own classification."
msgstr ""
"Esta cara ya fue clasificada por %(user)s. Solo esa persona puede cambiar"
" su propia clasificación."

#: app.py:3168 app.py:3267 app.py:3384
msgid "This face has already been classified by another contributor."
msgstr "Este rostro ya ha sido revisado por otro usuario"

#: app.py:3173
msgid "Failed to save reclassification"
msgstr "Error al guardar la reclasificación"

#: app.py:3411 app.py:3483 app.py:3533 app.py:3568 app.py:3784
msgid "Project not found or access denied"
msgstr "Proyecto no encontrado o acceso denegado"

#: app.py:3452
msgid "Your session has expired. Please log out and log in again to re-authorize."
msgstr ""
"Tu sesión ha expirado. Por favor, cierra sesión e inicia sesión de nuevo "
"para volver a autorizar."

#: app.py:3576
msgid "Invalid pagination parameters"
msgstr "Parámetros de paginación no válidos"

#: app.py:3891
msgid "Invalid status."
msgstr "Estado no válido."

#: app.py:3897
msgid "Invalid metadata pre-filter mode."
msgstr "Modo de prefiltro de metadatos no válido."

#: app.py:3933
msgid "Settings updated."
msgstr "Configuración actualizada."

#: app.py:3952 app.py:4357
#, python-format
msgid ""
"Warning: You currently have %(confirmed)d/%(min)d human-confirmed target "
"faces. Autonomous inference will not run until this threshold is met."
msgstr ""
"Advertencia: Actualmente tienes %(confirmed)d/%(min)d rostros objetivo "
"confirmados por humanos. La inferencia autónoma no se ejecutará hasta que"
" se alcance este umbral."

#: app.py:3962 app.py:4367
#, python-format
msgid ""
"Tip: You have %(count)d bootstrapped matches from existing Commons "
"depicts claims. Approve them in Model Results to count them as human-"
"confirmed."
msgstr ""
"Consejo: Tienes %(count)d coincidencias de bootstrap de declaraciones "
"depicts existentes en Commons. Apruébalas en Resultados del Modelo para "
"contarlas como confirmadas por humanos."

#: app.py:3974
msgid "Failed to update settings."
msgstr "Error al actualizar la configuración."

#: app.py:3995 app.py:4043
msgid "No member specified."
msgstr "No se especificó ningún miembro."

#: app.py:4001 app.py:4049
msgid "Invalid member."
msgstr "Miembro no válido."

#: app.py:4006
msgid "You cannot remove yourself from your own project."
msgstr "No puedes eliminarte a ti mismo de tu propio proyecto."

#: app.py:4016
msgid "Member removed and banned from rejoining."
msgstr "Miembro eliminado y expulsado permanentemente."

#: app.py:4018 app.py:4061
