#: templates/classify.html:479 templates/project_settings.html:60
msgid "Back to Project"
msgstr "Volver al proyecto"

#: templates/classify.html:460
msgid "All Caught Up!"
msgstr "¡Al día!"

#: templates/classify.html:461
msgid "No more faces to classify for this project right now."
msgstr "No hay más rostros para clasificar en este proyecto por ahora."

#: templates/classify.html:482
#, python-format
msgid "%(num)d review"
msgid_plural "%(num)d reviews"
msgstr[0] "%(num)d revisión"
msgstr[1] "%(num)d revisiones"

#: templates/classify.html:486
#, python-format
msgid "%(num)d remaining"
msgid_plural "%(num)d remaining"
msgstr[0] "%(num)d restante"
msgstr[1] "%(num)d restantes"

#: templates/classify.html:495
msgid "Model Review"
msgstr "Revisión del modelo"

#: templates/classify.html:496
msgid ""
"The model classified these faces as not matching. Confirm or correct "
"below."
msgstr ""
"El modelo clasificó estos rostros como no coincidentes. Confirma o "
"corrige abajo."

#: templates/classify.html:502
msgid "Click on the face if it actually is"
msgstr "Haz clic en el rostro si realmente es"

#: templates/classify.html:502
msgid ", or press \"None\" to confirm the model's rejection."
msgstr ", o presiona \"Ninguno\" para confirmar el rechazo del modelo."

#: templates/classify.html:504
msgid "Click on the face of"
msgstr "Haz clic en el rostro de"

#: templates/classify.html:504
msgid ", or press \"None\" if they are not in this photo."
msgstr ", o presiona \"Ninguno\" si no está en esta foto."

#: templates/classify.html:507
msgid "The model says this is not"
msgstr "El modelo dice que no es"

#: templates/classify.html:507
msgid ". Is that correct?"
msgstr ". ¿Es correcto?"

#: templates/classify.html:511
msgid "Draw a box around a missed face"
msgstr "Dibuja un cuadro alrededor de un rostro no detectado"

#: templates/classify.html:511 templates/classify.html:590
msgid "+ Add Missing Face"
msgstr "+ Añadir rostro faltante"

#: templates/classify.html:513
msgid "Show or hide the face labels"
msgstr "Mostrar u ocultar las etiquetas de las caras"

#: templates/classify.html:513 templates/classify.html:591
msgid "Hide labels"
msgstr "Ocultar etiquetas"

#: templates/classify.html:515
msgid "Click and drag on the image to draw a face box. Press Esc to cancel."
msgstr ""
"Haz clic y arrastra sobre la imagen para dibujar un cuadro de rostro. "
"Pulsa Esc para cancelar."

#: templates/classify.html:521
msgid "Image to classify"
msgstr "Imagen a clasificar"

#: templates/classify.html:528 templates/classify.html:530
#: templates/classify.html:560
#, python-format
msgid "Face %(num)d"
msgstr "Rostro %(num)d"

#: templates/classify.html:540 templates/classify.html:543
#: templates/classify.html:549
msgid "Yes"
msgstr "Sí"

#: templates/classify.html:540
msgid "Override Model"
msgstr "Anular modelo"

#: templates/classify.html:541 templates/classify.html:544
#: templates/classify.html:550
msgid "No"
msgstr "No"

#: templates/classify.html:541
msgid "Confirm Rejection"
msgstr "Confirmar rechazo"

