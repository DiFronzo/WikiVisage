msgstr[1] "%(num)d imágenes con rostros rechazados por el modelo para revisar."

#: templates/classify.html:446 templates/classify.html:465
#, python-format
msgid "%(num)d skipped image."
msgid_plural "%(num)d skipped images."
msgstr[0] "%(num)d imagen omitida."
msgstr[1] "%(num)d imágenes omitidas."

