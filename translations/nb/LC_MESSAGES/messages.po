msgid "Access is currently restricted to approved testers."
msgstr "Tilgang er for øyeblikket begrenset til godkjente testere."

#: app.py:842
msgid "Database error. Please try again."
msgstr "Databasefeil. Prøv igjen."

#: app.py:868
msgid "You have been logged out."
msgstr "Du er nå logget ut."

#: app.py:998
msgid "Failed to load projects."
msgstr "Kunne ikke laste prosjekter."

#: app.py:1205 app.py:1760 app.py:1925 app.py:2003 app.py:2265 app.py:2421
#: app.py:2556 app.py:2678 app.py:3012 app.py:3113 app.py:3161 app.py:3203
#: app.py:3248 app.py:3320 app.py:3451 app.py:3481
msgid "Invalid CSRF token"
msgstr "Ugyldig CSRF-token"

#: app.py:1216
msgid "Wikidata Q-ID must start with 'Q' (e.g., Q42)."
msgstr "Wikidata Q-ID må starte med 'Q' (f.eks. Q42)."

#: app.py:1218
msgid "Commons category is required."
msgstr "Commons-kategori er påkrevd."

#: app.py:1223 app.py:3023
msgid "Distance threshold must be between 0.1 and 1.0."
msgstr "Avstandsterskel må være mellom 0,1 og 1,0."

#: app.py:1225 app.py:3025
msgid "Distance threshold must be a number."
msgstr "Avstandsterskel må være et tall."

#: app.py:1231 app.py:3031
msgid "Minimum confirmed must be at least 1."
msgstr "Minimum bekreftet må være minst 1."

#: app.py:1233 app.py:3033
msgid "Minimum confirmed must be a whole number."
msgstr "Minimum bekreftet må være et heltall."

#: app.py:1241
#, python-format
msgid ""
"The Wikidata entity %(qid)s is not an instance of human (Q5). Only human "
"entities are supported."
msgstr ""
"Wikidata-entiteten %(qid)s er ikke en instans av menneske (Q5). Kun "
"menneskelige entiteter støttes."

#: app.py:1251
#, python-format
msgid "The Commons category \"%(category)s\" does not exist."
msgstr "Commons-kategorien «%(category)s» finnes ikke."

#: app.py:1276
msgid "A project with this Q-ID and category already exists."
msgstr "Et prosjekt med denne Q-ID-en og kategorien finnes allerede."

#: app.py:1306 app.py:3291
msgid "You are already a member of this project."
msgstr "Du er allerede medlem av dette prosjektet."

#: app.py:1311
#, python-format
msgid ""
"%(username)s already has a project for this Q-ID and category. You can "
"ask them for an invite code to join, or create your own."
msgstr ""
"%(username)s har allerede et prosjekt for denne Q-ID-en og kategorien. Du"
" kan be dem om en invitasjonskode for å bli med, eller opprette ditt "
"eget."

#: app.py:1352
msgid "Project created successfully!"
msgstr "Prosjektet ble opprettet!"

#: app.py:1397
msgid ""
"A previously deleted project with this Q-ID and category is still being "
"cleaned up. Please try again in a minute."
msgstr ""
"Et tidligere slettet prosjekt med denne Q-ID-en og kategorien ryddes "
"fortsatt opp. Prøv igjen om et minutt."

#: app.py:1404
msgid "Failed to create project. Please try again."
msgstr "Kunne ikke opprette prosjekt. Prøv igjen."

