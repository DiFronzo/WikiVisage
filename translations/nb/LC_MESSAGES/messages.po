#: app.py:4688
msgid "Invalid CSRF token"
msgstr "Ugyldig CSRF-token"

#: app.py:291 app.py:4983
msgid "Bad request"
msgstr "Ugyldig forespørsel"

#: app.py:353 app.py:389
msgid "Your session has expired. Please log in again."
msgstr "Økten din er utløpt. Vennligst logg inn igjen."

#: app.py:581
msgid "Invalid bounding box dimensions"
msgstr "Ugyldige dimensjoner for markeringsboks"

#: app.py:590
msgid "Bounding box out of allowed range"
msgstr "Markeringsboks utenfor tillatt område"

#: app.py:603 app.py:2554 app.py:3228
msgid "Missing required fields"
msgstr "Mangler påkrevde felt"

#: app.py:607 app.py:2560 app.py:3235
msgid "Invalid field values"
msgstr "Ugyldige feltverdier"

#: app.py:628
msgid "Too many face IDs in dismiss list"
msgstr "For mange ansikts-ID-er i avvisningslisten"

#: app.py:657
msgid "This image could not be read by the face detection service."
msgstr "Dette bildet kunne ikke leses av ansiktsgjenkjenningstjenesten."

#: app.py:660
msgid "Face detection service is unavailable. Please try again in a moment."
msgstr "Ansiktsdeteksjonstjenesten er utilgjengelig. Prøv igjen om litt."

#: app.py:663
msgid ""
"Could not compute face encoding for the selected region. Try drawing a "
"slightly larger box."
msgstr ""
"Kunne ikke beregne ansiktskoding for det valgte området. Prøv å tegne en "
"litt større boks."

#: app.py:672
#, python-format
msgid ""
"This face was already classified by %(user)s. Only they can change their "
"own classification."
msgstr ""
"Dette ansiktet er allerede klassifisert av %(user)s. Bare de kan endre "
"sin egen klassifisering."

#: app.py:676
msgid "This face has already been classified by another contributor."
msgstr "Dette ansiktet er allerede gjennomgått av en annen bruker"

#: app.py:797 app.py:5020
msgid "The service is temporarily unavailable. Please try again in a moment."
msgstr "Tjenesten er midlertidig utilgjengelig. Prøv igjen om et øyeblikk."

#: app.py:809
msgid "Please log in to continue."
msgstr "Vennligst logg inn for å fortsette."

#: app.py:886
msgid "Could not reach the Wikimedia login service. Please try again in a moment."
msgstr "Kunne ikke nå Wikimedias innloggingstjeneste. Prøv igjen om et øyeblikk."

#: app.py:888
msgid ""
"Your Wikimedia authorization has expired or was revoked. Please re-"
"authorize to continue."
msgstr ""
"Wikimedia-autorisasjonen din er utløpt eller trukket tilbake. Autoriser "
"på nytt for å fortsette."

#: app.py:1505
msgid "Invalid OAuth state. Please try again."
msgstr "Ugyldig OAuth-tilstand. Prøv igjen."

#: app.py:1524
msgid "Authentication failed. Please try again."
msgstr "Autentisering mislyktes. Prøv igjen."

#: app.py:1538
msgid "Could not retrieve your profile. Please try again."
msgstr "Kunne ikke hente profilen din. Prøv igjen."

#: app.py:1545
msgid "Invalid profile data received."
msgstr "Mottok ugyldige profildata."

#: app.py:1589
msgid "Database error. Please try again."
msgstr "Databasefeil. Prøv igjen."

#: app.py:1634
msgid "You have been logged out."
msgstr "Du er nå logget ut."

#: app.py:1837
msgid "Failed to load projects."
msgstr "Kunne ikke laste prosjekter."

#: app.py:2037
msgid "Wikidata Q-ID must start with 'Q' (e.g., Q42)."
msgstr "Wikidata Q-ID må starte med 'Q' (f.eks. Q42)."

#: app.py:2039
msgid "Commons category is required."
msgstr "Commons-kategori er påkrevd."

#: app.py:2045 app.py:4080
msgid "Distance threshold must be between 0.1 and 1.0."
msgstr "Avstandsterskel må være mellom 0,1 og 1,0."

#: app.py:2047 app.py:4082
msgid "Distance threshold must be a number."
msgstr "Avstandsterskel må være et tall."

#: app.py:2054 app.py:4088
msgid "Minimum confirmed must be at least 1."
msgstr "Minimum bekreftet må være minst 1."

#: app.py:2056 app.py:4090
msgid "Minimum confirmed must be a whole number."
msgstr "Minimum bekreftet må være et heltall."

#: app.py:2063
#, python-format
msgid ""
"The Wikidata entity %(qid)s is not an instance of human (Q5). Only human "
"entities are supported."
msgstr ""
"Wikidata-entiteten %(qid)s er ikke en instans av menneske (Q5). Kun "
"menneskelige entiteter støttes."

#: app.py:2069
#, python-format
msgid "The Commons category \"%(category)s\" does not exist."
msgstr "Commons-kategorien «%(category)s» finnes ikke."

#: app.py:2072
#, python-format
msgid "The Commons category \"%(category)s\" exists but contains no files."
msgstr "Commons-kategorien «%(category)s» finnes, men inneholder ingen filer."

#: app.py:2117 app.py:4416
msgid "You are already a member of this project."
msgstr "Du er allerede medlem av dette prosjektet."

#: app.py:2122
#, python-format
msgid ""
"%(username)s already has a project for this Q-ID and category. You can "
"ask them for an invite code to join, or create your own."
msgstr ""
"%(username)s har allerede et prosjekt for denne Q-ID-en og kategorien. Du"
" kan be dem om en invitasjonskode for å bli med, eller opprette ditt "
"eget."

#: app.py:2172
msgid "Project created successfully!"
msgstr "Prosjektet ble opprettet!"

#: app.py:2190 app.py:2202
msgid "Failed to create project. Please try again."
msgstr "Kunne ikke opprette prosjekt. Prøv igjen."

#: app.py:2195
msgid ""
"A previously deleted project with this Q-ID and category is still being "
"cleaned up. Please try again in a minute."
msgstr ""
"Et tidligere slettet prosjekt med denne Q-ID-en og kategorien ryddes "
"fortsatt opp. Prøv igjen om et minutt."

#: app.py:2224
msgid "A project with this Q-ID and category already exists."
msgstr "Et prosjekt med denne Q-ID-en og kategorien finnes allerede."

#: app.py:2566 app.py:2873 app.py:2997
msgid "Image not found or access denied"
msgstr "Bildet ble ikke funnet eller tilgang ble nektet"

#: app.py:2568 app.py:2736 app.py:2875 app.py:2882 app.py:2999 app.py:3256
#: app.py:3275 app.py:3488 app.py:3608 app.py:3629 app.py:3658 app.py:3681
#: app.py:3703 app.py:3732 app.py:3744 app.py:3767 app.py:3822 app.py:3915
#: app.py:3989
msgid "Database error"
msgstr "Databasefeil"

#: app.py:2642
msgid "Invalid face ID"
msgstr "Ugyldig ansikts-ID"

#: app.py:2715
msgid "Failed to save classification"
msgstr "Kunne ikke lagre klassifisering"

#: app.py:2734
msgid "Project not found"
msgstr "Fant ikke prosjektet"

#: app.py:2804
msgid ""
"Failed to remove SDC claim from Commons. The classification was not "
"undone."
msgstr ""
"Kunne ikke fjerne SDC-påstand fra Commons. Klassifiseringen ble ikke "
"angret."

#: app.py:2854 app.py:2867
msgid "Nothing to undo"
msgstr "Ingenting å angre"

#: app.py:2944
msgid "Failed to undo classification"
msgstr "Kunne ikke angre klassifisering"

#: app.py:2949 templates/project_detail.html:883
msgid "SDC claim was removed."
msgstr "SDC-påstanden ble fjernet."

#: app.py:2951 templates/project_detail.html:884
msgid "SDC claim removal queued."
msgstr "SDC-fjerning lagt i kø."

#: app.py:3002 app.py:3492
msgid "Image has not finished processing yet"
msgstr "Bildet er ikke ferdig behandlet ennå"

#: app.py:3076 app.py:3576
msgid "Failed to download image from Commons"
msgstr "Kunne ikke laste ned bilde fra Commons"

#: app.py:3079 app.py:3586
msgid "Failed to save face"
msgstr "Kunne ikke lagre ansikt"

#: app.py:3082 app.py:3589
msgid "Failed to process face region"
msgstr "Kunne ikke behandle ansiktsområdet"

#: app.py:3258 app.py:3486 app.py:3582
msgid "Face not found or access denied"
msgstr "Ansiktet ble ikke funnet eller tilgang ble nektet"

#: app.py:3286
msgid "Failed to remove SDC claim from Commons. The face was not reclassified."
msgstr ""
"Kunne ikke fjerne SDC-påstand fra Commons. Ansiktet ble ikke "
"omklassifisert."

#: app.py:3433
msgid "Failed to save reclassification"
msgstr "Kunne ikke lagre omklassifisering"

#: app.py:3606 app.py:3679 app.py:3730 app.py:3765 app.py:3987
msgid "Project not found or access denied"
msgstr "Prosjekt ikke funnet eller tilgang nektet"

#: app.py:3773
msgid "Invalid pagination parameters"
msgstr "Ugyldige pagineringsparametre"

#: app.py:4094
msgid "Invalid status."
msgstr "Ugyldig status."

#: app.py:4100
msgid "Invalid metadata pre-filter mode."
msgstr "Ugyldig modus for metadataforfilter."

#: app.py:4136
msgid "Settings updated."
msgstr "Innstillinger oppdatert."

#: app.py:4155 app.py:4560
#, python-format
msgid ""
"Warning: You currently have %(confirmed)d/%(min)d human-confirmed target "
"faces. Autonomous inference will not run until this threshold is met."
msgstr ""
"Advarsel: Du har for øyeblikket %(confirmed)d/%(min)d menneskebekreftede "
"målansikter. Autonom inferens vil ikke kjøre før denne terskelen er nådd."

#: app.py:4165 app.py:4570
#, python-format
msgid ""
"Tip: You have %(count)d bootstrapped matches from existing Commons "
"depicts claims. Approve them in Model Results to count them as human-"
"confirmed."
msgstr ""
"Tips: Du har %(count)d bootstrappede treff fra eksisterende depicts-"
"påstander på Commons. Godkjenn dem i Modellresultater for å telle dem som"
" menneskebekreftet."

#: app.py:4177
msgid "Failed to update settings."
msgstr "Kunne ikke oppdatere innstillingene."

#: app.py:4198 app.py:4246
msgid "No member specified."
msgstr "Ingen medlem angitt."

#: app.py:4204 app.py:4252
msgid "Invalid member."
msgstr "Ugyldig medlem."

#: app.py:4209
msgid "You cannot remove yourself from your own project."
msgstr "Du kan ikke fjerne deg selv fra ditt eget prosjekt."

#: app.py:4219
msgid "Member removed and banned from rejoining."
msgstr "Medlem fjernet og utestengt fra å bli med igjen."

#: app.py:4221 app.py:4264
msgid "Member not found."
msgstr "Medlem ikke funnet."

#: app.py:4224
msgid "Failed to remove member."
msgstr "Kunne ikke fjerne medlem."

#: app.py:4262
msgid "Member unbanned."
msgstr "Medlem er ikke lenger utestengt."

#: app.py:4267
msgid "Failed to unban member."
msgstr "Kunne ikke oppheve utestengelsen av medlem."

#: app.py:4288
msgid "You cannot leave a project you own. Delete it instead."
msgstr "Du kan ikke forlate et prosjekt du eier. Slett det i stedet."

#: app.py:4298
msgid "You have left the project."
msgstr "Du har forlatt prosjektet."

#: app.py:4300
msgid "You are not a member of this project."
msgstr "Du er ikke medlem av dette prosjektet."

#: app.py:4303
msgid "Failed to leave the project."
msgstr "Kunne ikke forlate prosjektet."

#: app.py:4335
msgid "Invite code generated."
msgstr "Invitasjonskode generert."

#: app.py:4347
msgid "Failed to generate invite code."
msgstr "Kunne ikke generere invitasjonskode."

#: app.py:4356
msgid "Invite code revoked."
msgstr "Invitasjonskode tilbakekalt."

#: app.py:4359
msgid "Failed to revoke invite code."
msgstr "Kunne ikke tilbakekalle invitasjonskode."

#: app.py:4361
msgid "Invalid action."
msgstr "Ugyldig handling."

#: app.py:4374
msgid "Please enter an invite code."
msgstr "Vennligst skriv inn en invitasjonskode."

#: app.py:4389 app.py:4409
msgid "Something went wrong. Please try again."
msgstr "Noe gikk galt. Vennligst prøv igjen."

#: app.py:4393
msgid "Invalid invite code."
msgstr "Ugyldig invitasjonskode."

#: app.py:4399
msgid "You are the owner of this project."
msgstr "Du er eieren av dette prosjektet."

#: app.py:4414
msgid "You have been banned from this project."
msgstr "Du har blitt utestengt fra dette prosjektet."

#: app.py:4427
#, python-format
msgid "Joined %(username)s's project \"%(label)s\" successfully!"
msgstr "Ble med i %(username)s sitt prosjekt «%(label)s»!"

#: app.py:4436
msgid "Failed to join project."
msgstr "Kunne ikke bli med i prosjektet."

#: app.py:4539
msgid "Failed to re-run inference."
msgstr "Kunne ikke kjøre inferens på nytt."

#: app.py:4547 templates/project_settings.html:286
msgid ""
"This project is paused. Set it to Active or Completed before re-running "
"inference."
msgstr ""
"Dette prosjektet er satt på pause. Sett det til Aktiv eller Fullført før "
"du kjører inferens på nytt."

#: app.py:4553 templates/project_settings.html:288
msgid ""
"A Commons edit run is in progress. Wait for it to finish (or stop it) "
"before re-running inference."
msgstr ""
"En Commons-redigering pågår. Vent til den er ferdig (eller stopp den) før"
" du kjører inferens på nytt."

#: app.py:4576
msgid "No faces were reset."
msgstr "Ingen ansikter ble tilbakestilt."

#: app.py:4583
#, python-format
msgid ""
"Reset %(num)d model-classified faces. The worker will re-classify them on"
" the next cycle."
msgstr ""
"Nullstilte %(num)d modellklassifiserte ansikter. Arbeideren vil "
"klassifisere dem på nytt i neste syklus."

#: app.py:4589
msgid "No model-classified faces to reset."
msgstr "Ingen modellklassifiserte ansikter å nullstille."

#: app.py:4601
#, python-format
msgid ""
"You have %(confirmed)d/%(min)d human-confirmed target faces — inference "
"will run on the next worker cycle."
msgstr ""
"Du har %(confirmed)d/%(min)d menneskebekreftede målansikter — inferens "
"kjøres ved neste arbeidssyklus."

#: app.py:4631
msgid "Project deleted."
msgstr "Prosjekt slettet."

#: app.py:4633
msgid "Project not found."
msgstr "Fant ikke prosjektet."

#: app.py:4636
msgid "Failed to delete project."
msgstr "Kunne ikke slette prosjekt."

#: app.py:4661
msgid "Settings saved."
msgstr "Innstillinger lagret."

#: app.py:4664
msgid "Failed to save settings."
msgstr "Kunne ikke lagre innstillingene."

#: app.py:4697
msgid "Could not log you out on all devices. Please try again."
msgstr "Kunne ikke logge deg ut på alle enheter. Prøv igjen."

#: app.py:4700
msgid "You have been logged out on all devices."
msgstr "Du er nå logget ut på alle enheter."

#: app.py:4777
msgid "Failed to load leaderboard."
msgstr "Kunne ikke laste ledertavle."

#: app.py:4990
msgid "Forbidden"
msgstr "Forbudt"

#: app.py:4997
msgid "Page not found"
msgstr "Siden ble ikke funnet"

#: app.py:5007
msgid "Rate limit exceeded. Please try again later."
msgstr "Hastighetsbegrensningen er nådd. Prøv igjen senere."

#: app.py:5032
msgid "Internal server error"
msgstr "Intern serverfeil"

#: templates/account_settings.html:3 templates/account_settings.html:66
