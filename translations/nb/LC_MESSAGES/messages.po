msgid "Project not found or access denied"
msgstr "Prosjekt ikke funnet eller tilgang nektet"

#: app.py:2777
msgid "Invalid status."
msgstr "Ugyldig status."

#: app.py:2803
msgid "Settings updated."
msgstr "Innstillinger oppdatert."

#: app.py:2821 app.py:2940
#, python-format
msgid ""
"Warning: You currently have %(confirmed)d/%(min)d human-confirmed target "
"faces. Autonomous inference will not run until this threshold is met."
msgstr ""
"Advarsel: Du har for øyeblikket %(confirmed)d/%(min)d menneskebekreftede "
"målansikter. Autonom inferens vil ikke kjøre før denne terskelen er nådd."

#: app.py:2831 app.py:2950
#, python-format
msgid ""
"Tip: You have %(count)d bootstrapped matches from existing Commons "
"depicts claims. Approve them in Model Results to count them as human-"
"confirmed."
msgstr ""
"Tips: Du har %(count)d bootstrappede treff fra eksisterende depicts-"
"påstander på Commons. Godkjenn dem i Modellresultater for å telle dem som"
" menneskebekreftet."

#: app.py:2844
msgid "Failed to update settings."
msgstr "Kunne ikke oppdatere innstillingene."

#: app.py:2869
msgid "Settings have not changed since the last inference run. No re-run needed."
msgstr ""
"Innstillingene er ikke endret siden forrige inferenskjøring. Ingen ny "
"kjøring nødvendig."

#: app.py:2898
#, python-format
msgid ""
"Reset %(num)d model-classified faces. The worker will re-classify them on"
" the next cycle."
msgstr ""
"Nullstilte %(num)d modellklassifiserte ansikter. Arbeideren vil "
"klassifisere dem på nytt i neste syklus."

#: app.py:2911
msgid "No model-classified faces to reset."
msgstr "Ingen modellklassifiserte ansikter å nullstille."

#: app.py:2930
#, python-format
msgid ""
"You have %(confirmed)d/%(min)d human-confirmed target faces — inference "
"will run on the next worker cycle."
msgstr ""
"Du har %(confirmed)d/%(min)d menneskebekreftede målansikter — inferens "
"kjøres ved neste arbeidssyklus."

#: app.py:2962
msgid "Failed to re-run inference."
msgstr "Kunne ikke kjøre inferens på nytt."

#: app.py:2987
msgid "Project deleted."
msgstr "Prosjekt slettet."

#: app.py:2989
msgid "Project not found."
msgstr "Fant ikke prosjektet."

#: app.py:2992
msgid "Failed to delete project."
msgstr "Kunne ikke slette prosjekt."

