msgid "Failed to download image from Commons"
msgstr "Échec du téléchargement de l'image depuis Commons"

#: app.py:2835 app.py:3391
msgid "Failed to save face"
msgstr "Échec de l'enregistrement du visage"

#: app.py:2838 app.py:3394
msgid "Failed to process face region"
msgstr "Échec du traitement de la région du visage"

#: app.py:3020 app.py:3246 app.py:3387
msgid "Face not found or access denied"
msgstr "Visage non trouvé ou accès refusé"

#: app.py:3056
msgid "Failed to remove SDC claim from Commons. The face was not reclassified."
msgstr ""
"Échec de la suppression de la déclaration SDC de Commons. Le visage n'a "
"pas été reclassifié."

#: app.py:3164 app.py:3263 app.py:3380
#, python-format
msgid ""
"This face was already classified by %(user)s. Only they can change their "
"own classification."
msgstr ""
"Ce visage a déjà été classé par %(user)s. Seule cette personne peut "
"modifier sa propre classification."

#: app.py:3168 app.py:3267 app.py:3384
msgid "This face has already been classified by another contributor."
msgstr "Ce visage a déjà été examiné par un autre utilisateur"

#: app.py:3173
