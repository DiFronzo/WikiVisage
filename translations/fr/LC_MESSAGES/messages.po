msgstr "Échec de l'enregistrement de la reclassification"

#: app.py:3411 app.py:3483 app.py:3533 app.py:3568 app.py:3784
msgid "Project not found or access denied"
msgstr "Projet non trouvé ou accès refusé"

#: app.py:3452
msgid "Your session has expired. Please log out and log in again to re-authorize."
msgstr ""
"Votre session a expiré. Veuillez vous déconnecter et vous reconnecter "
"pour autoriser à nouveau."

