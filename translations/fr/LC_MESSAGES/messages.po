msgid "Invalid pagination parameters"
msgstr "Paramètres de pagination invalides"

#: app.py:3891
msgid "Invalid status."
msgstr "Statut invalide."

#: app.py:3897
msgid "Invalid metadata pre-filter mode."
msgstr "Mode de préfiltrage des métadonnées non valide."

#: app.py:3933
msgid "Settings updated."
