msgid "Minimum confirmed must be a whole number."
msgstr "Le nombre minimum de confirmations doit être un nombre entier."

#: app.py:1315
#, python-format
msgid ""
"The Wikidata entity %(qid)s is not an instance of human (Q5). Only human "
"entities are supported."
msgstr ""
"L'entité Wikidata %(qid)s n'est pas une instance d'humain (Q5). Seules "
"les entités humaines sont prises en charge."

#: app.py:1325
#, python-format
msgid "The Commons category \"%(category)s\" does not exist."
msgstr "La catégorie Commons \"%(category)s\" n'existe pas."

#: app.py:1332
#, python-format
msgid "The Commons category \"%(category)s\" exists but contains no files."
msgstr ""
"La catégorie Commons \"%(category)s\" existe mais ne contient aucun "
"fichier."

#: app.py:1357
msgid "A project with this Q-ID and category already exists."
msgstr "Un projet avec ce Q-ID et cette catégorie existe déjà."

#: app.py:1387 app.py:3453
msgid "You are already a member of this project."
msgstr "Vous êtes déjà membre de ce projet."

#: app.py:1392
#, python-format
msgid ""
"%(username)s already has a project for this Q-ID and category. You can "
"ask them for an invite code to join, or create your own."
msgstr ""
"%(username)s a déjà un projet pour ce Q-ID et cette catégorie. Vous "
"pouvez lui demander un code d'invitation pour le rejoindre, ou créer le "
"vôtre."

